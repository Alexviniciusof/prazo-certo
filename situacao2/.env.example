# Copie este arquivo para .env e ajuste os valores. O .env não vai para o Git.

# development | production
APP_ENV=development

# Chave secreta do Flask (obrigatória em produção). Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Banco de dados. Sem esta variável, usa SQLite em instance/prazo_certo.db.
# PostgreSQL: DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/prazo_certo
# MySQL:      DATABASE_URL=mysql+pymysql://usuario:senha@localhost:3306/prazo_certo
DATABASE_URL=
